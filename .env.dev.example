APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://taskhub:taskhub-dev-only@localhost:5432/taskhub
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=dev-only-taskhub-secret-change-before-production-2026
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DOCS_ENABLED=true
CACHE_TTL_SECONDS=60
LOG_LEVEL=DEBUG
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_TIMEOUT_SECONDS=0.25
