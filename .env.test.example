APP_ENV=test
DATABASE_URL=sqlite+aiosqlite://
REDIS_URL=redis://localhost:6379/15
SECRET_KEY=test-secret-key-test-secret-key-1234567890
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
